      "def gather_samples():\n",
      "    \"\"\"Return list of (filepath, label_idx) for all 7 classes.\"\"\"\n",
      "    samples = []\n",
      "    for cls in CLASSES:\n",
      "        cls_dir = DATA_DIR / cls\n",
      "        for f in cls_dir.iterdir():\n",
      "            if f.suffix.lower() in VALID_EXT:\n",
      "                samples.append((str(f), CLASS_TO_IDX[cls]))\n",
      "    return samples\n",
      "\n",
      "(self, samples, split='train')\n",
      "(split='train')\n",
      "(train_set)\n"
     ]
    }
   ],
