    "import sys, time, json, numpy as np, torch, torch.nn as nn\n",
    "from pathlib import Path\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.metrics import f1_score, accuracy_score\n",
    "from torch.utils.data import DataLoader\n",
    "import timm\n",
    "sys.path.append(\"..\")\n",
    "from src.dataset import gather_samples, RiceLeafDataset\n",
    "\n",
    "N_FOLDS, SEED, BATCH, LR = 5, 42, 32, 1e-4\n",
    "MAX_EPOCHS, PATIENCE = 30, 7\n",
    "DEVICE = \"cuda\"\n",
    "OUT = Path(\"../results/cv\"); OUT.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "samples = gather_samples()\n",
    "labels = np.array([s[1] for s in samples])\n",
    "NUM_CLASSES = len(set(labels))\n",
    "print(len(samples), NUM_CLASSES, np.bincount(labels))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "048cd329",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_model():\n",
    "    return timm.create_model(\"convnext_tiny\", pretrained=True, num_classes=NUM_CLASSES).to(DEVICE)\n",
    "\n",
    "def evaluate(model, loader):\n",
    "    model.eval(); preds, gts = [], []\n",
    "    with torch.no_grad():\n",
    "        for x, y in loader:\n",
    "            preds += model(x.to(DEVICE)).argmax(1).cpu().tolist(); gts += y.tolist()\n",
    "    return f1_score(gts, preds, average=\"macro\"), accuracy_score(gts, preds), gts, preds\n",
    "\n",
    "def class_weights(tr_labels):\n",
    "    cnt = np.bincount(tr_labels, minlength=NUM_CLASSES)\n",
    "    return torch.tensor(len(tr_labels) / (NUM_CLASSES * cnt), dtype=torch.float32)\n",
    "\n",
    "def run_fold(fold, tr_idx, va_idx):\n",
    "    tr = [samples[i] for i in tr_idx]; va = [samples[i] for i in va_idx]\n",
    "    tl = DataLoader(RiceLeafDataset(tr, split=\"train\"), batch_size=BATCH, shuffle=True, num_workers=4)\n",
    "    vl = DataLoader(RiceLeafDataset(va, split=\"val\"), batch_size=BATCH, num_workers=4)\n",
    "    model = make_model()\n",
    "    w = class_weights([s[1] for s in tr]).to(DEVICE)\n",
    "    crit = nn.CrossEntropyLoss(weight=w)\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=LR)\n",
    "    sch = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, mode=\"max\", patience=3)\n",
    "    best, bad, best_state = -1, 0, None\n",
    "    for ep in range(MAX_EPOCHS):\n",
    "        model.train()\n",
    "        for x, y in tl:\n",
    "            opt.zero_grad()\n",
    "            loss = crit(model(x.to(DEVICE)), y.to(DEVICE)); loss.backward(); opt.step()\n",
    "        f1, acc, _, _ = evaluate(model, vl); sch.step(f1)\n",
    "        print(f\"fold{fold} ep{ep+1} f1={f1:.4f} acc={acc:.4f}\")\n",
    "        if f1 > best:\n",
    "            best, bad = f1, 0\n",
    "            best_state = {k: v.clone() for k, v in model.state_dict().items()}\n",
    "        else:\n",
    "            bad += 1\n",
    "            if bad >= PATIENCE: break\n",
    "    model.load_state_dict(best_state)\n",
    "    f1, acc, gts, preds = evaluate(model, vl)\n",
    "    return {\"fold\": fold, \"macro_f1\": f1, \"acc\": acc,\n",
    "            \"per_class_f1\": f1_score(gts, preds, average=None).tolist()}"
   ]
  },
